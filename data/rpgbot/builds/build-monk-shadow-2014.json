    "nodes": [
      {
        "nodeId": "section-ability-scores-2",
        "title": "Характеристики",
        "text": "Ми отримуємо два підвищення на +1, тож вкладемо їх у Спритність і Мудрість.\n\n Базове значення Підвищене значення Сила 8 8 Спритність 15 16 Статура 15 15 Інтелект 8 8 Мудрість 15 16 Харизма 8 8",
        "sourceRefs": [
          {
            "articleId": "rpgbot-monk-shadow-2014",
            "translationRevisionId": "translation-rpgbot-monk-shadow-2014-draft1",
            "sourceRevisionId": "rpgbot-4a7eefd98b9f9163-98f801c95e92bee6",
            "sectionId": "section-ability-scores-2",
            "ratingIds": []
          }
        ]
      },
      {
        "nodeId": "section-race",
        "title": "Раса",
        "text": "Варіант людини{{Variant Human}}. Нам дуже потрібна риса на 1-му рівні, щоб отримати «Містичного адепта». Ми також отримуємо додаткову навичку, що приємно.",
        "sourceRefs": [
          {
            "articleId": "rpgbot-monk-shadow-2014",
            "translationRevisionId": "translation-rpgbot-monk-shadow-2014-draft1",
            "sourceRevisionId": "rpgbot-4a7eefd98b9f9163-98f801c95e92bee6",
            "sectionId": "section-race",
            "ratingIds": []
          }
        ]
      },
      {
        "nodeId": "section-background",
        "title": "Передісторія",
        "text": "Безпритульний{{Urchin}}. Ми отримуємо чудові навички та Інструменти злодія, що дає змогу легко замінити Пройдисвіта в групі.",
        "sourceRefs": [
          {
            "articleId": "rpgbot-monk-shadow-2014",
            "translationRevisionId": "translation-rpgbot-monk-shadow-2014-draft1",
            "sourceRevisionId": "rpgbot-4a7eefd98b9f9163-98f801c95e92bee6",
            "sectionId": "section-background",
            "ratingIds": []
          }
        ]
      },
      {
        "nodeId": "section-skills-and-tools",
        "title": "Навички й інструменти",
        "text": "Серед класових навичок оберемо Аналіз поведінки та Непомітність. Безпритульний дає Спритність рук і Непомітність, а зайву Непомітність замінимо на Уважність. Додаткову навичку від Варіанта людини використаємо на Розслідування. Також від Безпритульного отримуємо Інструменти злодія та ігровий набір. Це дає все потрібне, щоб бути розвідником нашої групи.",
        "sourceRefs": [
          {
            "articleId": "rpgbot-monk-shadow-2014",
            "translationRevisionId": "translation-rpgbot-monk-shadow-2014-draft1",
            "sourceRevisionId": "rpgbot-4a7eefd98b9f9163-98f801c95e92bee6",
            "sectionId": "section-skills-and-tools",
            "ratingIds": []
          }
        ]
      },
      {
        "nodeId": "section-feats-2",
        "title": "Риси",
        "text": "На 1-му рівні беремо «Містичного адепта» заради «Зору диявола». Темнозір — це чудово, але здатність бачити в магічній темряві абсолютно критична для Шляху тіні.\n\nНа 4-му рівні беремо «Вартового»{{Sentinel}}.\n\nРешту часу — лише підвищення характеристик.",
        "sourceRefs": [
          {
            "articleId": "rpgbot-monk-shadow-2014",
            "translationRevisionId": "translation-rpgbot-monk-shadow-2014-draft1",
            "sourceRevisionId": "rpgbot-4a7eefd98b9f9163-98f801c95e92bee6",
            "sectionId": "section-feats-2",
            "ratingIds": []
          }
        ]
      }
    ],
    "levelPlans": [
      {
        "level": 1,
        "text": "Захист без броні, Бойові мистецтва",
        "notes": "На цьому рівні ми — дуже типовий Монах. Візьміть спис і/або палицю й атакуйте нею двома руками заради більшої кістки шкоди.",
