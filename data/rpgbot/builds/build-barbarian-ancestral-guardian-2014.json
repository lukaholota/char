    "nodes": [
      {
        "nodeId": "section-abilities",
        "title": "Характеристики",
        "text": " Базове значення Підвищене значення Сила 12 13 Спритність 15 16 Статура 15 16 Інтелект 13 13 Мудрість 8 8 Харизма 8 8",
        "sourceRefs": [
          {
            "articleId": "rpgbot-barbarian-ancestral-guardian-2014",
            "translationRevisionId": "translation-rpgbot-barbarian-ancestral-guardian-2014-draft1",
            "sourceRevisionId": "rpgbot-12fd08c88513f38f-13703f80957bf346",
            "sectionId": "section-abilities",
            "ratingIds": []
          }
        ]
      },
      {
        "nodeId": "section-race",
        "title": "Раса",
        "text": "Шадар-Кай{{Shadar-Kai}} із «Монстрів Мультивсесвіту» чудовий, як описано в нашому розборі рас для Варвара. Він також ельф.",
        "sourceRefs": [
          {
            "articleId": "rpgbot-barbarian-ancestral-guardian-2014",
            "translationRevisionId": "translation-rpgbot-barbarian-ancestral-guardian-2014-draft1",
            "sourceRevisionId": "rpgbot-12fd08c88513f38f-13703f80957bf346",
            "sectionId": "section-race",
            "ratingIds": []
          }
        ]
      },
      {
        "nodeId": "section-background",
        "title": "Передісторія",
        "text": "Оберіть Артиста{{Entertainer}}. Обміняйте Виступ на Непомітність, а володіння Набором для гриму на Інструменти злодія. Вітаю, ви — роуді.",
        "sourceRefs": [
          {
            "articleId": "rpgbot-barbarian-ancestral-guardian-2014",
            "translationRevisionId": "translation-rpgbot-barbarian-ancestral-guardian-2014-draft1",
            "sourceRevisionId": "rpgbot-12fd08c88513f38f-13703f80957bf346",
            "sectionId": "section-background",
            "ratingIds": []
          }
        ]
      },
      {
        "nodeId": "section-skills-and-tools",
        "title": "Навички й інструменти",
        "text": "Оскільки наш Інтелект пристойний, беремо Природу й Розслідування. Разом із навичками з передісторії (Акробатика й Непомітність) ми стаємо напрочуд добрим Розвідником і заміною Пройдисвіта. Хоча ми занедбуємо і Мудрість, і Харизму, додаткові володіння від додаткового класового уміння «Первісне знання» можуть стати в пригоді, якщо ви колись захочете залякувати людей чи тварин.",
        "sourceRefs": [
          {
            "articleId": "rpgbot-barbarian-ancestral-guardian-2014",
            "translationRevisionId": "translation-rpgbot-barbarian-ancestral-guardian-2014-draft1",
            "sourceRevisionId": "rpgbot-12fd08c88513f38f-13703f80957bf346",
            "sectionId": "section-skills-and-tools",
            "ratingIds": []
          }
        ]
      },
      {
        "nodeId": "section-feats",
        "title": "Риси",
        "text": "Збірка тримається на «Ельфійській точності», тож беремо її на 4-му. Далі стає дивно. Ми насправді не отримуємо наступне підвищення характеристик до 10-го рівня персонажа, але ми жорстоко ламаємо фундаментальну математику, щоб насправді не відставати. Один дивний рівень, де ми підвищуємо і Спритність, і Статуру, а потім «Кухар», щоб заокруглити це до парного числа.",
        "sourceRefs": [
          {
            "articleId": "rpgbot-barbarian-ancestral-guardian-2014",
            "translationRevisionId": "translation-rpgbot-barbarian-ancestral-guardian-2014-draft1",
            "sourceRevisionId": "rpgbot-12fd08c88513f38f-13703f80957bf346",
            "sectionId": "section-feats",
            "ratingIds": []
          }
        ]
      }
    ],
    "levelPlans": [
