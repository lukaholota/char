        "sourceRefs": [
          {
            "articleId": "rpgbot-sorcerer-divine-soul-2014",
            "translationRevisionId": "translation-rpgbot-sorcerer-divine-soul-2014-draft1",
            "sourceRevisionId": "rpgbot-11f66f9873161de9-1645ed783f6b584c",
