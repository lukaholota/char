            "sectionId": "section-level",
            "ratingIds": []
          }
        ]
      },
      {
        "level": 4,
        "text": "Риса: Кухар (Мудрість 16 → 18)\nПокращення Дикої форми",
        "sourceRefs": [
          {
            "articleId": "rpgbot-druid-circle-of-dreams-2014",
            "translationRevisionId": "translation-rpgbot-druid-circle-of-dreams-2014-draft1",
