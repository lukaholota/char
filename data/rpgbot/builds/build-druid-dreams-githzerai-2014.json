    "nodes": [
      {
        "nodeId": "section-abilities",
        "title": "Характеристики",
        "text": "Беремо типовий для друїдів розподіл: 15 у Статурі й Мудрості та 14 у Спритності. Середні обладунки обмежують Спритність на 14, тож більше нам не потрібно. Решту 2 очки можна вкласти туди, де ви хочете 10 замість 8. Від нашої раси отримуємо збільшення +1/+2, щоб дійти до Статури 16 і Мудрості 17.\n\n Базове значення Підвищене значення 20-й рівень Сила 8 8 8 Спритність 14 14 14 Статура 15 16 20 Інтелект 10 10 10 Мудрість 15 17 20 Харизма 8 8 8",
        "sourceRefs": [
          {
            "articleId": "rpgbot-druid-circle-of-dreams-2014",
            "translationRevisionId": "translation-rpgbot-druid-circle-of-dreams-2014-draft1",
            "sourceRevisionId": "rpgbot-74b04a9032e03f34-9e19f374cd8de714",
            "sectionId": "section-abilities",
            "ratingIds": []
          }
        ]
      },
      {
        "nodeId": "section-race",
        "title": "Раса",
        "text": "Для раси беремо Ґітцерай{{Githzerai}}, бо Лімб{{Limbo}} якось схожий на сон. Але ще й тому, що вона дає нам заклинання Щит [Shield].",
        "sourceRefs": [
          {
            "articleId": "rpgbot-druid-circle-of-dreams-2014",
            "translationRevisionId": "translation-rpgbot-druid-circle-of-dreams-2014-draft1",
            "sourceRevisionId": "rpgbot-74b04a9032e03f34-9e19f374cd8de714",
            "sectionId": "section-race",
            "ratingIds": []
          }
        ]
      },
      {
        "nodeId": "section-background",
        "title": "Передісторія",
        "text": "Беремо Далекий мандрівник{{Far Traveler}} заради Аналізу поведінки й Уважності. А ще це логічно: ми далеко мандрували від Лімбу{{Limbo}}.",
        "sourceRefs": [
          {
            "articleId": "rpgbot-druid-circle-of-dreams-2014",
            "translationRevisionId": "translation-rpgbot-druid-circle-of-dreams-2014-draft1",
            "sourceRevisionId": "rpgbot-74b04a9032e03f34-9e19f374cd8de714",
            "sectionId": "section-background",
            "ratingIds": []
          }
        ]
      },
      {
        "nodeId": "section-skills-and-tools",
        "title": "Навички й інструменти",
        "text": "Від Друїда беремо Природу й Виживання. Від Далекого мандрівника отримуємо Аналіз поведінки й Уважність.",
        "sourceRefs": [
          {
            "articleId": "rpgbot-druid-circle-of-dreams-2014",
            "translationRevisionId": "translation-rpgbot-druid-circle-of-dreams-2014-draft1",
            "sourceRevisionId": "rpgbot-74b04a9032e03f34-9e19f374cd8de714",
            "sectionId": "section-skills-and-tools",
            "ratingIds": []
          }
        ]
      },
      {
        "nodeId": "section-feats",
        "title": "Риси",
        "text": "На 4-му рівні беремо «Кухаря»{{Chef}} і вкладаємо +1 в Мудрість.\n\nНа 8-му рівні беремо Покращення Характеристик на +2 до Мудрості.\n\nНа 12-му рівні беремо «Стійкого»{{Resilient}}, щоб підсилити наші ряткидки Статури.\n\nНа 16-му рівні беремо «Експерта у навичках»{{Skill Expert}}, щоб округлити наше непарне значення Статури.\n\nНа 19-му рівні беремо ще одне Покращення Характеристик на +2 до Статури.",
        "sourceRefs": [
          {
            "articleId": "rpgbot-druid-circle-of-dreams-2014",
            "translationRevisionId": "translation-rpgbot-druid-circle-of-dreams-2014-draft1",
            "sourceRevisionId": "rpgbot-74b04a9032e03f34-9e19f374cd8de714",
            "sectionId": "section-feats",
            "ratingIds": []
          }
        ]
      }
    ],
    "levelPlans": [
      {
        "level": 1,
        "text": "Чаротворство\nЗамовляння:\n– Створення вогню\n– Терновий батіг\nЗаклинання 1-го рівня:\n– Поглинання стихій\n– Цілюще слово\n– Вогники фей\n– Громова хвиля",
        "sourceRefs": [
          {
            "articleId": "rpgbot-druid-circle-of-dreams-2014",
            "translationRevisionId": "translation-rpgbot-druid-circle-of-dreams-2014-draft1",
            "sourceRevisionId": "rpgbot-74b04a9032e03f34-9e19f374cd8de714",
            "sectionId": "section-level",
            "ratingIds": []
          }
        ]
      },
      {
        "level": 2,
        "text": "Дика форма\nКоло сновидінь\nБальзам літнього двору",
        "sourceRefs": [
          {
            "articleId": "rpgbot-druid-circle-of-dreams-2014",
            "translationRevisionId": "translation-rpgbot-druid-circle-of-dreams-2014-draft1",
            "sourceRevisionId": "rpgbot-74b04a9032e03f34-9e19f374cd8de714",
            "sectionId": "section-level",
            "ratingIds": []
          }
        ]
      },
      {
        "level": 3,
        "text": "Заклинання 2-го рівня:\n– Покращення здібності\n– Переміщення без сліду\n– Проростання шипів",
        "sourceRefs": [
          {
            "articleId": "rpgbot-druid-circle-of-dreams-2014",
            "translationRevisionId": "translation-rpgbot-druid-circle-of-dreams-2014-draft1",
