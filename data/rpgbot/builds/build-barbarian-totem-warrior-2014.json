          {
            "articleId": "rpgbot-barbarian-totem-warrior-2014",
            "translationRevisionId": "translation-rpgbot-barbarian-totem-warrior-2014-draft1",
            "sourceRevisionId": "rpgbot-a52bf037e6d0c1ef-9db757499f29ee06",
            "sectionId": "section-levels",
            "ratingIds": []
          }
        ]
      },
      {
        "level": 4,
        "text": "Риса: Майстер древкової зброї",
        "sourceRefs": [
          {
            "articleId": "rpgbot-barbarian-totem-warrior-2014",
            "translationRevisionId": "translation-rpgbot-barbarian-totem-warrior-2014-draft1",
            "sourceRevisionId": "rpgbot-a52bf037e6d0c1ef-9db757499f29ee06",
            "sectionId": "section-levels",
            "ratingIds": []
          }
        ]
      },
      {
        "level": 5,
        "text": "Додаткова атака, Швидкий рух",
