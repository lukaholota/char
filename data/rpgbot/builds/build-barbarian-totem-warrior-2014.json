    "nodes": [
      {
        "nodeId": "section-abilities",
        "title": "Характеристики",
        "text": "Використовуємо купівлю характеристик на по 15 Сили, Спритності й Статури. Потім отримуємо 3 +1 від расового вибору й додаємо їх, щоб почати з трьома 16.\n\n Купівля характеристик Підвищене значення 20-й рівень Сила 15 16 24 Спритність 15 16 16 Статура 15 15 24 Інтелект 8 8 8 Мудрість 8 8 8 Харизма 8 8 8\n\nЗавдяки «Первісному чемпіону», вершині Варвара, ця збірка може закінчити з 24 Сили й Статури.",
        "sourceRefs": [
          {
            "articleId": "rpgbot-barbarian-totem-warrior-2014",
            "translationRevisionId": "translation-rpgbot-barbarian-totem-warrior-2014-draft1",
            "sourceRevisionId": "rpgbot-a52bf037e6d0c1ef-9db757499f29ee06",
            "sectionId": "section-abilities",
            "ratingIds": []
          }
        ]
      },
      {
        "nodeId": "section-race",
        "title": "Раса",
        "text": "Для цієї збірки ми обрали Еладріна{{Eladrin}}, бо телепортація бонусною дією — дуже зручна риса. Хоч Шадар-Кай теж спокусливий вибір, у нас уже є опори до шкоди від «Люті», а корисність форми Весняного еладріна дуже зручна.\n\nТелепортувати охочого союзника бонусною дією — це найближче до «спецкидка фастбол», що ми можемо отримати, і це занадто весело, щоб пропустити.",
        "sourceRefs": [
          {
            "articleId": "rpgbot-barbarian-totem-warrior-2014",
            "translationRevisionId": "translation-rpgbot-barbarian-totem-warrior-2014-draft1",
            "sourceRevisionId": "rpgbot-a52bf037e6d0c1ef-9db757499f29ee06",
            "sectionId": "section-race",
            "ratingIds": []
          }
        ]
      },
      {
        "nodeId": "section-background",
        "title": "Передісторія",
        "text": "Ми обрали Чужинця{{Outlander}}, що дає володіння Атлетикою й Виживанням, а також музичним інструментом на наш вибір.\n\nВтім, порада: якщо можете, замініть його на Дикого космонавта{{Wildspacer}}, щоб отримати ті самі навички, але ще й безкоштовну рису «Здоровань». Ці додаткові ХП чудові.",
        "sourceRefs": [
          {
            "articleId": "rpgbot-barbarian-totem-warrior-2014",
            "translationRevisionId": "translation-rpgbot-barbarian-totem-warrior-2014-draft1",
            "sourceRevisionId": "rpgbot-a52bf037e6d0c1ef-9db757499f29ee06",
            "sectionId": "section-background",
            "ratingIds": []
          }
        ]
      },
      {
        "nodeId": "section-skills-and-tools",
        "title": "Навички й інструменти",
        "text": "Від Еладріна ми отримуємо Уважність. Від Варвара обираємо Залякування й Природу. Від Чужинця отримуємо Атлетику й Виживання.",
        "sourceRefs": [
          {
            "articleId": "rpgbot-barbarian-totem-warrior-2014",
            "translationRevisionId": "translation-rpgbot-barbarian-totem-warrior-2014-draft1",
            "sourceRevisionId": "rpgbot-a52bf037e6d0c1ef-9db757499f29ee06",
            "sectionId": "section-skills-and-tools",
            "ratingIds": []
          }
        ]
      },
      {
        "nodeId": "section-feats",
        "title": "Риси",
        "text": "На четвертому рівні беремо «Майстра древкової зброї». Приріст DPR від цієї риси не слід недооцінювати.\n\nНа восьмому рівні беремо підвищення характеристик на +2 Сили.\n\nНа дванадцятому рівні беремо підвищення характеристик на +2 Сили.\n\nНа шістнадцятому рівні беремо підвищення характеристик на +2 Статури.\n\nНа девʼятнадцятому рівні беремо підвищення характеристик на +2 Статури.",
        "sourceRefs": [
          {
            "articleId": "rpgbot-barbarian-totem-warrior-2014",
            "translationRevisionId": "translation-rpgbot-barbarian-totem-warrior-2014-draft1",
            "sourceRevisionId": "rpgbot-a52bf037e6d0c1ef-9db757499f29ee06",
            "sectionId": "section-feats",
            "ratingIds": []
          }
        ]
      }
    ],
    "levelPlans": [
      {
        "level": 1,
        "text": "Лють, Захист без обладунків\nНавички: Атлетика, Залякування, Природа, Уважність, Виживання\nФейський крок",
        "sourceRefs": [
          {
            "articleId": "rpgbot-barbarian-totem-warrior-2014",
            "translationRevisionId": "translation-rpgbot-barbarian-totem-warrior-2014-draft1",
            "sourceRevisionId": "rpgbot-a52bf037e6d0c1ef-9db757499f29ee06",
            "sectionId": "section-levels",
            "ratingIds": []
          }
        ]
      },
      {
        "level": 2,
        "text": "Відчуття небезпеки, Безрозсудна атака",
        "sourceRefs": [
          {
            "articleId": "rpgbot-barbarian-totem-warrior-2014",
            "translationRevisionId": "translation-rpgbot-barbarian-totem-warrior-2014-draft1",
            "sourceRevisionId": "rpgbot-a52bf037e6d0c1ef-9db757499f29ee06",
            "sectionId": "section-levels",
            "ratingIds": []
          }
        ]
      },
      {
        "level": 3,
        "text": "Шлях тотемного воїна\nДух тотема: Вовк\nШукач духів",
