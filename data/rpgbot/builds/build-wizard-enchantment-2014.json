            "translationRevisionId": "translation-rpgbot-wizard-enchantment-2014-draft1",
            "sourceRevisionId": "rpgbot-e98185cb2dbb53fd-68e6ab726fcc37b8",
            "sectionId": "section-levels",
            "ratingIds": []
          }
        ]
