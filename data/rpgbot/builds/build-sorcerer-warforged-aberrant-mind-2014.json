            "articleId": "rpgbot-sorcerer-aberrant-mind-2014",
            "translationRevisionId": "translation-rpgbot-sorcerer-aberrant-mind-2014-draft1",
            "sourceRevisionId": "rpgbot-a3099a850001fed5-e581c5cb68238bf1",
            "sectionId": "section-levels",
