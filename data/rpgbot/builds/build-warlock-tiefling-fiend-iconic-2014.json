            "sourceRevisionId": "rpgbot-8b363750bc57a71d-db54a4278881ca45",
            "sectionId": "section-levels",
            "ratingIds": []
          }
        ]
      },
      {
        "level": 17,
        "text": "Містичний арканум: Істинне перевтілення\nНове відоме заклинання:\n– будь-яке",
