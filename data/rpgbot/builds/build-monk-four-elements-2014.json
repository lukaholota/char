            "ratingIds": []
          }
        ]
      },
      {
        "level": 12,
        "text": "Покращення Характеристик: Мудрість 16 → 18",
        "sourceRefs": [
          {
            "articleId": "rpgbot-monk-four-elements-2014",
            "translationRevisionId": "translation-rpgbot-monk-four-elements-2014-draft1",
            "sourceRevisionId": "rpgbot-e24e1161d37c1764-f0e199f062d2821e",
