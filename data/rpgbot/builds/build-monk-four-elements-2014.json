    "nodes": [
      {
        "nodeId": "section-ability-scores-2",
        "title": "Характеристики",
        "text": "Вкладіть +1 у Спритність/Статуру/Мудрість. Цілком типове для Монаха.\n\n Базове значення Підвищене значення Сила 8 8 Спритність 15 16 Статура 15 16 Інтелект 8 8 Мудрість 15 16 Харизма 8 8",
        "sourceRefs": [
          {
            "articleId": "rpgbot-monk-four-elements-2014",
            "translationRevisionId": "translation-rpgbot-monk-four-elements-2014-draft1",
            "sourceRevisionId": "rpgbot-e24e1161d37c1764-f0e199f062d2821e",
            "sectionId": "section-ability-scores-2",
            "ratingIds": []
          }
        ]
      },
      {
        "nodeId": "section-race",
        "title": "Раса",
        "text": "Гоблін із MotM{{Goblin}}. «Спритна втеча»{{Nimble Escape}} дублює деякі наші класові уміння, але, що показово, не витрачає Кі. Нам треба розтягувати Кі якомога більше, щоб звільнити місце для умінь підкласу. Також можна застосовувати бонус шкоди «Люті маленького»{{Fury of the Small}} до наших заклинань проти однієї цілі.",
        "sourceRefs": [
          {
            "articleId": "rpgbot-monk-four-elements-2014",
            "translationRevisionId": "translation-rpgbot-monk-four-elements-2014-draft1",
            "sourceRevisionId": "rpgbot-e24e1161d37c1764-f0e199f062d2821e",
            "sectionId": "section-race",
            "ratingIds": []
          }
        ]
      },
      {
        "nodeId": "section-background",
        "title": "Передісторія",
        "text": "Відлюдник{{Hermit}}. Монастирське життя звучить доречно.",
        "sourceRefs": [
          {
            "articleId": "rpgbot-monk-four-elements-2014",
            "translationRevisionId": "translation-rpgbot-monk-four-elements-2014-draft1",
            "sourceRevisionId": "rpgbot-e24e1161d37c1764-f0e199f062d2821e",
            "sectionId": "section-background",
            "ratingIds": []
          }
        ]
      },
      {
        "nodeId": "section-skills-and-tools",
        "title": "Навички й інструменти",
        "text": "Не має значення.",
        "sourceRefs": [
          {
            "articleId": "rpgbot-monk-four-elements-2014",
            "translationRevisionId": "translation-rpgbot-monk-four-elements-2014-draft1",
            "sourceRevisionId": "rpgbot-e24e1161d37c1764-f0e199f062d2821e",
            "sectionId": "section-skills-and-tools",
            "ratingIds": []
          }
        ]
      },
      {
        "nodeId": "section-feats-2",
        "title": "Риси",
        "text": "Беремо виключно підвищення характеристик, щоб якнайшвидше довести Спритність і Мудрість до 20. Спритність потрібна, щоб наші атаки працювали, а Мудрість — щоб наші Складності ряткидків були достатньо високими для підтримки наших Складностей ряткидків.",
        "sourceRefs": [
          {
            "articleId": "rpgbot-monk-four-elements-2014",
            "translationRevisionId": "translation-rpgbot-monk-four-elements-2014-draft1",
            "sourceRevisionId": "rpgbot-e24e1161d37c1764-f0e199f062d2821e",
            "sectionId": "section-feats-2",
            "ratingIds": []
          }
        ]
      }
    ],
    "levelPlans": [
      {
        "level": 1,
        "text": "Захист без броні, Бойові мистецтва",
        "sourceRefs": [
          {
            "articleId": "rpgbot-monk-four-elements-2014",
            "translationRevisionId": "translation-rpgbot-monk-four-elements-2014-draft1",
            "sourceRevisionId": "rpgbot-e24e1161d37c1764-f0e199f062d2821e",
            "sectionId": "section-levels",
            "ratingIds": []
          }
        ]
      },
      {
        "level": 2,
        "text": "Кі, Рух без броні, Присвячена зброя",
        "sourceRefs": [
          {
            "articleId": "rpgbot-monk-four-elements-2014",
            "translationRevisionId": "translation-rpgbot-monk-four-elements-2014-draft1",
            "sourceRevisionId": "rpgbot-e24e1161d37c1764-f0e199f062d2821e",
            "sectionId": "section-levels",
            "ratingIds": []
          }
        ]
      },
      {
        "level": 3,
        "text": "Підклас: Шлях чотирьох стихій, Учень стихій, Стихійна дисципліна: Кулак непорушного повітря, Відхилення снарядів, Атака, посилена Кі",
        "sourceRefs": [
          {
            "articleId": "rpgbot-monk-four-elements-2014",
            "translationRevisionId": "translation-rpgbot-monk-four-elements-2014-draft1",
            "sourceRevisionId": "rpgbot-e24e1161d37c1764-f0e199f062d2821e",
            "sectionId": "section-levels",
            "ratingIds": []
          }
        ]
      },
      {
        "level": 4,
        "text": "Покращення Характеристик: Спритність 16 → 18, Повільне падіння, Швидке зцілення",
        "sourceRefs": [
          {
            "articleId": "rpgbot-monk-four-elements-2014",
            "translationRevisionId": "translation-rpgbot-monk-four-elements-2014-draft1",
            "sourceRevisionId": "rpgbot-e24e1161d37c1764-f0e199f062d2821e",
            "sectionId": "section-levels",
            "ratingIds": []
          }
        ]
      },
      {
        "level": 5,
        "text": "Додаткова атака, Приголомшливий удар, Зосереджене прицілювання",
        "sourceRefs": [
          {
            "articleId": "rpgbot-monk-four-elements-2014",
            "translationRevisionId": "translation-rpgbot-monk-four-elements-2014-draft1",
            "sourceRevisionId": "rpgbot-e24e1161d37c1764-f0e199f062d2821e",
            "sectionId": "section-levels",
            "ratingIds": []
          }
        ]
      },
      {
        "level": 6,
        "text": "Удари, посилені Кі, Стихійна дисципліна: Гонг вершини",
        "sourceRefs": [
          {
            "articleId": "rpgbot-monk-four-elements-2014",
            "translationRevisionId": "translation-rpgbot-monk-four-elements-2014-draft1",
            "sourceRevisionId": "rpgbot-e24e1161d37c1764-f0e199f062d2821e",
            "sectionId": "section-levels",
            "ratingIds": []
          }
        ]
      },
      {
        "level": 7,
        "text": "Ухилення, Спокій розуму",
        "sourceRefs": [
          {
            "articleId": "rpgbot-monk-four-elements-2014",
            "translationRevisionId": "translation-rpgbot-monk-four-elements-2014-draft1",
            "sourceRevisionId": "rpgbot-e24e1161d37c1764-f0e199f062d2821e",
            "sectionId": "section-levels",
            "ratingIds": []
          }
        ]
      },
      {
        "level": 8,
        "text": "Покращення Характеристик: Спритність 18 → 20",
        "sourceRefs": [
          {
            "articleId": "rpgbot-monk-four-elements-2014",
            "translationRevisionId": "translation-rpgbot-monk-four-elements-2014-draft1",
            "sourceRevisionId": "rpgbot-e24e1161d37c1764-f0e199f062d2821e",
            "sectionId": "section-levels",
            "ratingIds": []
          }
        ]
      },
      {
        "level": 9,
        "text": "Покращення Руху без броні",
        "sourceRefs": [
          {
            "articleId": "rpgbot-monk-four-elements-2014",
            "translationRevisionId": "translation-rpgbot-monk-four-elements-2014-draft1",
            "sourceRevisionId": "rpgbot-e24e1161d37c1764-f0e199f062d2821e",
            "sectionId": "section-levels",
            "ratingIds": []
          }
        ]
      },
      {
        "level": 10,
        "text": "Чистота тіла{{Purity of Body}}",
        "sourceRefs": [
          {
            "articleId": "rpgbot-monk-four-elements-2014",
            "translationRevisionId": "translation-rpgbot-monk-four-elements-2014-draft1",
            "sourceRevisionId": "rpgbot-e24e1161d37c1764-f0e199f062d2821e",
            "sectionId": "section-levels",
            "ratingIds": []
          }
        ]
      },
      {
        "level": 11,
        "text": "Стихійна дисципліна: Полумʼя фенікса, Заміна стихійної дисципліни: Гонг вершини → Осідлати вітер",
        "sourceRefs": [
          {
            "articleId": "rpgbot-monk-four-elements-2014",
