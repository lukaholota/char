    "nodes": [
      {
        "nodeId": "section-ability-scores-2",
        "title": "Характеристики",
        "text": "Досить типово для Варвара.\n\n Базове значення Підвищене значення Сила 15 17 Спритність 14 14 Статура 15 17 Інтелект 8 8 Мудрість 10 10 Харизма 8 8",
        "sourceRefs": [
          {
            "articleId": "rpgbot-barbarian-battlerager-2014",
            "translationRevisionId": "translation-rpgbot-barbarian-battlerager-2014-draft1",
            "sourceRevisionId": "rpgbot-3a20e0174036ce9d-514786c31110c8e3",
            "sectionId": "section-ability-scores-2",
            "ratingIds": []
          }
        ]
      },
      {
        "nodeId": "section-race",
        "title": "Раса",
        "text": "Розглянемо три варіанти: Пагорбовий дворф, Совин і Ааракокра.\n\nГірський дворф заради двох підвищень +2. Нам потрібні високі модифікатори і Сили, і Статури.\n\nСовин{{Owlin}}. Оригінальна версія Ааракокри краща завдяки вищій швидкості, але з оновленою версією Ааракокри з сильно зменшеною швидкістю Совин краще підходить завдяки Темному зору й додатковій навичці. Технічно тут підійде будь-яка літаюча раса середнього розміру.",
        "sourceRefs": [
          {
            "articleId": "rpgbot-barbarian-battlerager-2014",
            "translationRevisionId": "translation-rpgbot-barbarian-battlerager-2014-draft1",
            "sourceRevisionId": "rpgbot-3a20e0174036ce9d-514786c31110c8e3",
            "sectionId": "section-race",
            "ratingIds": []
          }
        ]
      },
      {
        "nodeId": "section-background",
        "title": "Передісторія",
        "text": "Не важливо для збірки.",
        "sourceRefs": [
          {
            "articleId": "rpgbot-barbarian-battlerager-2014",
            "translationRevisionId": "translation-rpgbot-barbarian-battlerager-2014-draft1",
            "sourceRevisionId": "rpgbot-3a20e0174036ce9d-514786c31110c8e3",
            "sectionId": "section-background",
            "ratingIds": []
          }
        ]
      },
      {
        "nodeId": "section-skills-and-tools",
        "title": "Навички й інструменти",
        "text": "Ми отримаємо загалом 4 навички від класу й Передісторії. Якщо ви Совин, ви отримаєте володіння Непомітністю. Доки ви володієте Атлетикою, решта не має значення.",
        "sourceRefs": [
          {
            "articleId": "rpgbot-barbarian-battlerager-2014",
            "translationRevisionId": "translation-rpgbot-barbarian-battlerager-2014-draft1",
            "sourceRevisionId": "rpgbot-3a20e0174036ce9d-514786c31110c8e3",
            "sectionId": "section-skills-and-tools",
            "ratingIds": []
          }
        ]
      },
      {
        "nodeId": "section-feats-2",
        "title": "Риси",
        "text": "На 4-му рівні беремо «Експерта в навичках»{{Skill Expert}}, щоб підвищити Силу до 18 і отримати Експертизу в Атлетиці. Ми також отримуємо володіння ще однією навичкою.\n\nНа 8-му рівні підвищуємо Статуру до 19.\n\nНа 12-му рівні беремо «Рухливого»{{Mobile}}.\n\nНа 16-му рівні ділимо підвищення характеристики між Силою й Статурою, щоб Сила стала 19, а Статура — 20.\n\nНа 19-му рівні беремо «Проколювача»{{Piercer}} і піднімаємо Силу до 20.",
        "sourceRefs": [
          {
            "articleId": "rpgbot-barbarian-battlerager-2014",
            "translationRevisionId": "translation-rpgbot-barbarian-battlerager-2014-draft1",
            "sourceRevisionId": "rpgbot-3a20e0174036ce9d-514786c31110c8e3",
            "sectionId": "section-feats-2",
            "ratingIds": []
          }
        ]
      }
    ],
    "levelPlans": [
      {
        "level": 1,
        "text": "Лють, Захист без обладунків",
        "sourceRefs": [
          {
            "articleId": "rpgbot-barbarian-battlerager-2014",
            "translationRevisionId": "translation-rpgbot-barbarian-battlerager-2014-draft1",
            "sourceRevisionId": "rpgbot-3a20e0174036ce9d-514786c31110c8e3",
            "sectionId": "section-levels",
            "ratingIds": []
          }
        ]
      },
      {
        "level": 2,
        "text": "Безрозсудна атака, Відчуття небезпеки",
        "sourceRefs": [
          {
            "articleId": "rpgbot-barbarian-battlerager-2014",
            "translationRevisionId": "translation-rpgbot-barbarian-battlerager-2014-draft1",
            "sourceRevisionId": "rpgbot-3a20e0174036ce9d-514786c31110c8e3",
            "sectionId": "section-levels",
            "ratingIds": []
          }
        ]
      },
      {
        "level": 3,
        "text": "Первісний Шлях{{Primal Path}}: Бойовий шаленець, Обладунок лютого, Первісне знання",
        "sourceRefs": [
          {
            "articleId": "rpgbot-barbarian-battlerager-2014",
            "translationRevisionId": "translation-rpgbot-barbarian-battlerager-2014-draft1",
            "sourceRevisionId": "rpgbot-3a20e0174036ce9d-514786c31110c8e3",
            "sectionId": "section-levels",
            "ratingIds": []
          }
        ]
      },
      {
        "level": 4,
        "text": "Риса: Експерт у навичках – Сила 17 → 18 – Експертиза: Атлетика – Володіння: будь-яке",
        "sourceRefs": [
          {
            "articleId": "rpgbot-barbarian-battlerager-2014",
            "translationRevisionId": "translation-rpgbot-barbarian-battlerager-2014-draft1",
