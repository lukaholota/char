    "nodes": [
      {
        "nodeId": "section-abilities",
        "title": "Характеристики",
        "text": "Характеристики трохи відрізняються від наведених вище заради безкоштовних заклинань і бонусів +2/+1/+1 Напівельфа.\n\n Базові Підвищені Сил 8 8 Спр 15 17 Ста 12 12 Інт 8 8 Муд 15 16 Хар 13 14",
        "sourceRefs": [
          {
            "articleId": "rpgbot-ranger-beast-master-2014",
            "translationRevisionId": "translation-rpgbot-ranger-beast-master-2014-draft1",
            "sourceRevisionId": "rpgbot-c20794434f3ec477-d3cfe5fd9996e551",
            "sectionId": "section-abilities",
            "ratingIds": []
          }
        ]
      },
      {
        "nodeId": "section-race",
        "title": "Раса",
        "text": "Напівельф{{Half-Elf}} дроу. Увесь колорит дроу, половина темнозору. Також прибирає згубну Чутливість до сонячного світла, що дуже цінно.",
        "sourceRefs": [
          {
            "articleId": "rpgbot-ranger-beast-master-2014",
            "translationRevisionId": "translation-rpgbot-ranger-beast-master-2014-draft1",
            "sourceRevisionId": "rpgbot-c20794434f3ec477-d3cfe5fd9996e551",
            "sectionId": "section-race",
            "ratingIds": []
          }
        ]
      },
      {
        "nodeId": "section-background",
        "title": "Походження",
        "text": "Передісторія відображає не дитинство, а десятиліття мандрів Підмороком далеко від цивілізації. Обираємо Відлюдника{{Hermit}} й замінюємо Релігію на Виживання.",
        "sourceRefs": [
          {
            "articleId": "rpgbot-ranger-beast-master-2014",
            "translationRevisionId": "translation-rpgbot-ranger-beast-master-2014-draft1",
            "sourceRevisionId": "rpgbot-c20794434f3ec477-d3cfe5fd9996e551",
            "sectionId": "section-background",
            "ratingIds": []
          }
        ]
      },
      {
        "nodeId": "section-skills-and-tools",
        "title": "Навички й інструменти",
        "text": "Відлюдник дає Медицину, Виживання й володіння Набором травника. Слідопит дає Уважність, Поводження з тваринами й Непомітність.",
        "sourceRefs": [
          {
            "articleId": "rpgbot-ranger-beast-master-2014",
            "translationRevisionId": "translation-rpgbot-ranger-beast-master-2014-draft1",
            "sourceRevisionId": "rpgbot-c20794434f3ec477-d3cfe5fd9996e551",
            "sectionId": "section-skills-and-tools",
            "ratingIds": []
          }
        ]
      },
      {
        "nodeId": "section-feats",
        "title": "Риси",
        "text": "На 4-му рівні беремо {{Ельфійська точність|Elven Accuracy}}. Тварина-супутник забезпечує обхід із флангу, якщо граєте з цим опціональним правилом; інакше є Вогники фей [Faerie fire] від Магії дроу.\n\nНа 8-му рівні максимізуємо Спритність.\n\nНа 12-му рівні беремо {{Посвячений у бій|Fighting Initiate}} із {{Бій наосліп|Blind Fighting}}, щоб використовувати Темрява [Darkness] та/або Туманна хмара [Fog Cloud].\n\nРівні 16 і 19 максимізують Мудрість, щоб супутник не втрачав ефективності.",
        "sourceRefs": [
          {
            "articleId": "rpgbot-ranger-beast-master-2014",
            "translationRevisionId": "translation-rpgbot-ranger-beast-master-2014-draft1",
            "sourceRevisionId": "rpgbot-c20794434f3ec477-d3cfe5fd9996e551",
            "sectionId": "section-feats",
            "ratingIds": []
          }
        ]
      }
    ],
    "levelPlans": [
      {
        "level": 1,
        "text": "{{Вправний дослідник - Кмітливий|Deft Explorer - Canny}}; {{Мічений ворог|Favored Foe}}",
        "sourceRefs": [
          {
            "articleId": "rpgbot-ranger-beast-master-2014",
