    "title": "DnD 5.5 Cult of the Dragon Initiate Feat Guide | 2024 DnD",
    "authors": [
      "T.E. \"RPGBOT\" Kamstra"
    ],
    "sourceFile": "source/rpgbot-92093338921f686b-f66aebb0188e6b3b.html",
