    "title": "DnD 5e Epic Boons Guide",
    "authors": [
      "T.E. \"RPGBOT\" Kamstra"
    ],
    "sourceFile": "source/rpgbot-4d9d65ebdbd80a93-11751e1ba42590f4.html",
