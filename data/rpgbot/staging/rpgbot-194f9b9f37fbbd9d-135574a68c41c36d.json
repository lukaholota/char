    "title": "DnD 5.5 Cold Caster Feat Guide | 2024 DnD",
    "authors": [
      "T.E. \"RPGBOT\" Kamstra"
    ],
    "sourceFile": "source/rpgbot-194f9b9f37fbbd9d-135574a68c41c36d.html",
