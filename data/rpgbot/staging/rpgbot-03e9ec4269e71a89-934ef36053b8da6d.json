  "sections": [
    {
      "sectionId": "section-introduction",
      "heading": "Introduction",
      "sourceAnchor": "introduction",
      "blocks": [
        {
          "blockId": "block-section-introduction-1",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "\n\tThe Enclave Magic feat leans hard into working with animals, but doesn’t solve\n\tthe issue that animals are very easily handled by other means and stop being a\n\tthreat by around level 9. The feat’s features are dubiously useful even at low\n\tlevels, and are outright obsolete with access to the right level 1 spells.\n"
            }
          ]
        },
        {
          "blockId": "block-section-introduction-2",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "\n\tThis is a bad feat. Thematically, it should be great for Druids and Rangers,\n\tbut they already get spells that make this feat useless.\n"
            }
          ]
        },
        {
          "blockId": "block-section-introduction-3",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Enclave Magic requires the "
            },
            {
              "type": "link",
              "text": "Emerald Enclave Fledgling",
              "href": "https://rpgbot.net/2024-dnd/feats/emerald-enclave-fledgling/"
            },
            {
              "type": "text",
              "text": " feat."
            }
          ]
        }
      ]
    },
    {
      "sectionId": "section-ability-score-increase",
      "heading": "Ability Score Increase",
      "sourceAnchor": "ability-score-increase",
      "blocks": [
        {
          "blockId": "block-section-ability-score-increase-1",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Any mental stat. Easy for casters."
            }
          ]
        }
      ]
    },
    {
      "sectionId": "section-friend-to-animals",
      "heading": "Friend to Animals",
      "sourceAnchor": "friend-to-animals",
      "blocks": [
        {
          "blockId": "block-section-friend-to-animals-1",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "\n\tAnimal Friendship is a level 1 spell that lasts 24 hours and works almost\n\tunerringly. If you want to be friends with animals, cast Animal Friendship or\n\tDominate Beast.\n"
            }
          ]
        }
      ]
    },
    {
      "sectionId": "section-two-hearts-one-mind",
      "heading": "Two Hearts, One Mind",
      "sourceAnchor": "two-hearts-one-mind",
      "blocks": [
        {
          "blockId": "block-section-two-hearts-one-mind-1",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "If you want to see through a beast’s senses, cast Find Familiar."
            }
          ]
        }
      ]
    }
  ],
