    "title": "Artificer Initiate: DnD 5e Feat Guide",
    "authors": [
      "T.E. \"RPGBOT\" Kamstra"
    ],
    "sourceFile": "source/rpgbot-eacaaaf09509cde0-5fa8167a527cd673.html",
