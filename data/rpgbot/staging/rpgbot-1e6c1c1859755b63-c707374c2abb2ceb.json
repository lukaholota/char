      "sectionId": "section-introduction",
      "heading": "Introduction",
      "sourceAnchor": "introduction",
      "blocks": [
        {
          "blockId": "block-section-introduction-1",
          "type": "paragraph",
          "content": [
            {
              "type": "link",
              "text": "Weapon Mastery",
              "href": "https://www.dndbeyond.com/sources/dnd/phb-2024/equipment#MasteryProperties"
            },
            {
              "type": "text",
              "text": " is the only truly “new” system in the updated DnD 5.5 rules, and it’s an exciting addition to the game. By providing martial characters with additional tactical options, characters can impact combat in more interesting ways without relying on spellcasting."
            }
          ]
        },
        {
          "blockId": "block-section-introduction-2",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "You may also enjoy our RPGBOT.Podcast episode discussing "
            },
            {
              "type": "link",
              "text": "Weapon Mastery",
              "href": "https://rpgbot.net/2024-dd-phb-weapon-mastery-breakdown-if-you-attack-something-youre-going-to-do-damage-rpgbot-podcast-s4e89/"
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        }
      ]
    },
