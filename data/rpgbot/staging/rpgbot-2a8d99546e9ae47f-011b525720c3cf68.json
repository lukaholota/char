  "sections": [
    {
      "sectionId": "section-introduction",
      "heading": "Introduction",
      "sourceAnchor": "introduction",
      "blocks": [
        {
          "blockId": "block-section-introduction-1",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The Vampire’s Plaything feat gives you a few options for surviving and escaping harm. The Timely Retreat feature is especially appealing for characters built to fight exclusively at range or for melee builds worried about moving too slowly to reach their enemies."
            }
          ]
        },
        {
          "blockId": "block-section-introduction-2",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Vampire’s Plaything is available from the Vampire’s Plaything background published in Astarion’s Book of Hungers."
            }
          ]
        }
      ]
    },
    {
      "sectionId": "section-decanting",
      "heading": "Decanting",
      "sourceAnchor": "decanting",
      "blocks": [
        {
          "blockId": "block-section-decanting-1",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "This is nice at low levels, but the potion of healing will diminish in effectiveness as you advance, and the cost to purchase antitoxins quickly becomes negligible as players’ wealth grows exponentially with level."
            }
          ]
        }
      ]
    },
    {
      "sectionId": "section-timely-retreat",
      "heading": "Timely Retreat",
      "sourceAnchor": "timely-retreat",
      "blocks": [
        {
          "blockId": "block-section-timely-retreat-1",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Fantastic mobility a few times per day. For characters who need to move quickly sometimes or who are worried about being caught in melee and can’t teleport, this is fantastic."
            }
          ]
        },
        {
          "blockId": "block-section-timely-retreat-2",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "This is useless for Goblins, Monks, and Rogues. Orcs will also find less value here thanks to their Adrenaline Rush trait."
            }
          ]
        }
      ]
    },
    {
      "sectionId": "section-vampiric-connection",
      "parentSectionId": "section-timely-retreat",
      "heading": "Vampiric Connection",
      "sourceAnchor": "vampiric-connection",
      "blocks": [
        {
          "blockId": "block-section-vampiric-connection-1",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "This has no specific mechanical effect, but it is a fantastic storytelling device."
            }
          ]
        }
      ]
    }
  ],
