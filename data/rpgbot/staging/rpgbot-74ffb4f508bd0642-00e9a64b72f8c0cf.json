  "sections": [
    {
      "sectionId": "intro",
      "heading": "DnD 5.5 Feats: Character Optimization Guides | 2024 DnD",
      "blocks": [
        {
          "blockId": "block-intro-1",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Feats are a powerful mechanic in the 2024 DnD rules, allowing you to customize your character’s capabilities beyond the options offered by your class."
            }
          ]
        },
        {
          "blockId": "block-intro-2",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The list below is not a comprehensive list of feat options, but it does list all of our currently published feat guides. If you would like to see a guide for a feat which we haven’t covered yet, "
            },
            {
              "type": "link",
              "text": "email us",
              "href": "https://rpgbot.net/cdn-cgi/l/email-protection#95c7c5d2d7dac1d5c7c5d2d7dac1bbfbf0e1"
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        }
      ]
    },
