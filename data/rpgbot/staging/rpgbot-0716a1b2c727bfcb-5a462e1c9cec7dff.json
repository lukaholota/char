    {
      "sectionId": "section-background",
      "parentSectionId": "section-example",
      "heading": "Background",
      "sourceAnchor": "background",
      "blocks": [
        {
          "blockId": "block-section-background-1",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Strength and Con means either Farmer or Soldier. As we’re intending to be a Defender, we take Farmer for Tough."
            }
          ]
        }
      ]
    },
    {
      "sectionId": "section-species",
