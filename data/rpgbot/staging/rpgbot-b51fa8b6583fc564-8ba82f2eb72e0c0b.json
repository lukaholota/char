    "title": "DnD 5.5 Harper Agent Feat Guide | 2024 DnD",
    "authors": [
      "T.E. \"RPGBOT\" Kamstra"
    ],
    "sourceFile": "source/rpgbot-b51fa8b6583fc564-8ba82f2eb72e0c0b.html",
