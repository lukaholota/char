    "title": "DnD 5.5 Purple Dragon Commandant Feat Guide | 2024 DnD",
    "authors": [
      "T.E. \"RPGBOT\" Kamstra"
    ],
    "sourceFile": "source/rpgbot-2f8ffd30bdc13e44-06b7d4089af291dd.html",
    "evidence": "Owner explicitly requested the RPGbot full-text crawl on 2026-09-29"
