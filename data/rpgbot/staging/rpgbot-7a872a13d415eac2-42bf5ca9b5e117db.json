    "contentHash": "58e308916aaae95677f8527e8cae29b2ff128bb7f7938f6c56ec742e8d53a7c7",
    "title": "DnD 5.5 Street Justice Feat Guide | 2024 DnD",
    "authors": [
      "T.E. \"RPGBOT\" Kamstra"
    ],
    "sourceFile": "source/rpgbot-7a872a13d415eac2-42bf5ca9b5e117db.html",
    "evidence": "Owner explicitly requested the RPGbot full-text crawl on 2026-09-29"
