    "title": "Deep Gnome: DnD 5e Race/Species Guide",
    "authors": [
      "T.E. \"RPGBOT\" Kamstra"
    ],
    "sourceFile": "source/rpgbot-28214a9ccc812bfe-1aaffd29c2a9ec39.html",
