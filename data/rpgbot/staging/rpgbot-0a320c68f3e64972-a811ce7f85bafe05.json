  "sections": [
    {
      "sectionId": "intro",
      "heading": "DnD 5.5 Species: Character Optimization Guides",
      "blocks": [
        {
          "blockId": "block-intro-1",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "One of the first choices you make when creating a DnD character, your choice of species provides a collection of useful traits."
            }
          ]
        },
        {
          "blockId": "block-intro-2",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The 2014 DnD 5e rules used the term “race,” while the 2024 DnD 5.5 rules have switched to the term “species.” For rules purposes, the terms are interchangeable."
            }
          ]
        },
        {
          "blockId": "block-intro-3",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The list below is not a comprehensive list of species options, but it does list all of our currently published species guides. If you would like to see a guide for a species which we haven’t covered yet, "
            },
            {
              "type": "link",
              "text": "email us",
              "href": "https://rpgbot.net/cdn-cgi/l/email-protection#4b191b0c09041f0b191b0c09041f65252e3f"
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        }
      ]
    },
