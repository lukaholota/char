    "title": "DnD 5.5 Infernal Bulwark Feat Guide",
    "authors": [
      "T.E. \"RPGBOT\" Kamstra"
    ],
    "sourceFile": "source/rpgbot-c8c58296c3700e67-b92e84e12b3ca51a.html",
    "evidence": "Owner explicitly requested the RPGbot full-text crawl on 2026-09-29"
