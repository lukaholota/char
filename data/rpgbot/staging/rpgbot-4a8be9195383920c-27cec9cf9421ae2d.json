    "title": "Fire Genasi: DnD 5e Race/Species Guide",
    "authors": [
      "T.E. \"RPGBOT\" Kamstra"
    ],
    "sourceFile": "source/rpgbot-4a8be9195383920c-27cec9cf9421ae2d.html",
