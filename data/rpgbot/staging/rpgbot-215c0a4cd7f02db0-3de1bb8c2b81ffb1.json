    "title": "Half-Orc: DnD 5e Race/Species Guide",
    "authors": [
      "T.E. \"RPGBOT\" Kamstra"
    ],
    "sourceFile": "source/rpgbot-215c0a4cd7f02db0-3de1bb8c2b81ffb1.html",
