    "title": "Githyanki: DnD 5e Race/Species Guide",
    "authors": [
      "T.E. \"RPGBOT\" Kamstra"
    ],
    "sourceFile": "source/rpgbot-daad8f965dabf775-2d6e79e39472e50b.html",
