    "title": "DnD 5.5 Infernal Pact Feat Guide",
    "authors": [
      "T.E. \"RPGBOT\" Kamstra"
    ],
    "sourceFile": "source/rpgbot-6ae4e7c22895ac20-4e6532603421d7c9.html",
