  "sections": [
    {
      "sectionId": "section-introduction",
      "heading": "Introduction",
      "sourceAnchor": "introduction",
      "blocks": [
        {
          "blockId": "block-section-introduction-1",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The Light Bringer feat gives you the ability to produce magical sunlight with a Cantrip. It’s fantastic if you’re worried about vampires and other creatures sensitive to sunlight, but otherwise it will provide very little value."
            }
          ]
        }
      ]
    },
    {
      "sectionId": "section-ability-score-increase",
      "heading": "Ability Score Increase",
      "sourceAnchor": "ability-score-increase",
      "blocks": [
        {
          "blockId": "block-section-ability-score-increase-1",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Any mental ability."
            }
          ]
        }
      ]
    },
    {
      "sectionId": "section-sacred-magic",
      "heading": "Sacred Magic",
      "sourceAnchor": "sacred-magic",
      "blocks": [
        {
          "blockId": "block-section-sacred-magic-1",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "A free cantrip is nice. If you’re not a Cleric, this is a sneaky way to get access to powerful Cleric cantrips like Guidance."
            }
          ]
        }
      ]
    },
    {
      "sectionId": "section-solar-luminance",
      "heading": "Solar Luminance",
      "sourceAnchor": "solar-luminance",
      "blocks": [
        {
          "blockId": "block-section-solar-luminance-1",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "1 hour of sunlight a day. Great for Vitamin D, terrible for vampires, myconids, and creatures like drow that often have Sunlight Sensitivity."
            }
          ]
        }
      ]
    },
    {
      "sectionId": "section-suns-healing",
      "heading": "Sun’s Healing",
      "sourceAnchor": "suns-healing",
      "blocks": [
        {
          "blockId": "block-section-suns-healing-1",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Once per rest is not enough."
            }
          ]
        }
      ]
    }
  ],
