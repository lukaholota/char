    "title": "Kender: DnD 5e Race/Species Guide",
    "authors": [
      "T.E. \"RPGBOT\" Kamstra"
    ],
    "sourceFile": "source/rpgbot-be52b7f752c6f1b7-026ffec634b5c7e3.html",
