  "sections": [
    {
      "sectionId": "section-introduction",
      "heading": "Glory of the Giants Introduction",
      "sourceAnchor": "introduction",
      "blocks": [
        {
          "blockId": "block-section-introduction-1",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Glory of the Giants presents a collection of new giant-themed feats, emphasizing giant’s runic magic and elemental power of individual varieties of giants. These feats are intended to be accessed at least in part via the newly-introduced backgrounds, and use the feat tree design first introduced to 5e in Dragonlance: Shadow of the Dragon Queen."
            }
          ]
        },
        {
          "blockId": "block-section-introduction-2",
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Because gaining access to these feats works differently from other feats, such as those in the 2014 Player’s Handbook, they require a little bit of additional examination to determine how to best use them."
            }
          ]
        }
      ]
    },
