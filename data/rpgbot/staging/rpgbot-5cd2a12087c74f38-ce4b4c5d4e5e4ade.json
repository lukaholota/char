    "title": "Water Genasi: DnD 5e Race/Species Guide",
    "authors": [
      "T.E. \"RPGBOT\" Kamstra"
    ],
    "sourceFile": "source/rpgbot-5cd2a12087c74f38-ce4b4c5d4e5e4ade.html",
