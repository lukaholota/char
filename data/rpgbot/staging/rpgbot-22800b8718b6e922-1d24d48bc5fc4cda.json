    "title": "DnD 5.5 Infernal Dragoon Feat Guide",
    "authors": [
      "T.E. \"RPGBOT\" Kamstra"
    ],
    "sourceFile": "source/rpgbot-22800b8718b6e922-1d24d48bc5fc4cda.html",
