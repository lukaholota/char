    "title": "DnD 5.5 Fey Tormentor Feat Guide",
    "authors": [
      "T.E. \"RPGBOT\" Kamstra"
    ],
    "sourceFile": "source/rpgbot-0dd79f1b73a0631c-55fe3ed47d11c779.html",
