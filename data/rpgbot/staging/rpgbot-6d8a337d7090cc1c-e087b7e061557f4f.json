    "title": "Eladrin: DnD 5e Race/Species Guide",
    "authors": [
      "T.E. \"RPGBOT\" Kamstra"
    ],
    "sourceFile": "source/rpgbot-6d8a337d7090cc1c-e087b7e061557f4f.html",
