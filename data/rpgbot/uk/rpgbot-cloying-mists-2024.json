  "translations": [
    {
      "translationRevisionId": "translation-rpgbot-cloying-mists-2024-draft1",
      "articleId": "rpgbot-cloying-mists-2024",
      "sourceRevisionId": "rpgbot-f229e5aaf0a32512-a51ae4aa78519aff",
