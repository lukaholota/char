  "translations": [
    {
      "translationRevisionId": "translation-rpgbot-vampires-plaything-2024-draft1",
      "articleId": "rpgbot-vampires-plaything-2024",
      "sourceRevisionId": "rpgbot-2a8d99546e9ae47f-011b525720c3cf68",
