                0,
                0
              ],
              "itemKinds": [
                "unordered",
                "unordered",
                "unordered",
                "unordered"
              ]
            }
          ]
        },
        {
          "sectionId": "section-disclaimer",
          "heading": "Як читати оцінки RPGbot",
          "sourceAnchor": "disclaimer",
          "blocks": [
            {
              "blockId": "block-section-disclaimer-1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "RPGbot використовує кольорову шкалу, яку легко зрозуміти й швидко переглянути. Вона допомагає гравцям свідомо обирати варіанти для своїх персонажів D&D."
                }
              ]
            },
            {
              "blockId": "block-section-disclaimer-2",
              "type": "list",
              "ordered": false,
              "items": [
                [
                  {
                    "type": "text",
                    "text": "Червоний: погані, марні або вкрай ситуативні варіанти. Майже ніколи не корисні."
                  }
                ],
                [
                  {
                    "type": "text",
                    "text": "Помаранчевий: прийнятні варіанти або корисні лише за рідкісних обставин. Іноді стають у пригоді."
                  }
                ],
                [
                  {
                    "type": "text",
                    "text": "Зелений: хороші варіанти. Часто корисні."
                  }
                ],
                [
                  {
                    "type": "text",
                    "text": "Синій: чудові варіанти, нерідко необхідні для роботи персонажа. Дуже часто корисні."
                  }
                ]
              ],
              "depths": [
                0,
                0,
                0,
                0
              ],
              "itemKinds": [
                "unordered",
                "unordered",
                "unordered",
                "unordered"
              ]
            },
            {
              "blockId": "block-section-disclaimer-3",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Наведені нижче поради спираються на поточний "
                },
                {
                  "type": "link",
                  "text": "стан оптимізації персонажів D&D 5e 2014",
                  "href": "https://rpgbot.net/dnd5/characters/state-of-the-meta/"
                },
                {
                  "type": "text",
                  "text": " на момент останнього оновлення статті. Памʼятайте: цей стан час від часу змінюється з виходом нових матеріалів, і статтю буде оновлено відповідно, наскільки дозволить час."
                }
              ]
            },
            {
              "blockId": "block-section-disclaimer-4",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "У гайдах за офіційними матеріалами ми не розглядаємо матеріали сторонніх видавців, «Відкритої Аркани»{{Unearthed Arcana}} чи домашні правила, бо не можемо припускати, що вони дозволені у вашій грі."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "section-classes-custom-origin",
          "heading": "Леонін: класи з налаштуванням походження",
          "sourceAnchor": "classes-custom-origin",
          "blocks": [
            {
              "blockId": "block-section-classes-custom-origin-1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Цей розділ припускає, що ви використовуєте опціональні правила «"
                },
                {
                  "type": "link",
                  "text": "Налаштування походження",
                  "href": "https://www.dndbeyond.com/sources/tcoe/character-options#CustomizingYourOrigin"
                },
                {
                  "type": "text",
                  "text": "» з книги Казан Таші з усім. Якщо ні, прокрутіть до наступного розділу."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "section-custom-origin-artificer",
          "parentSectionId": "section-classes-custom-origin",
          "heading": "Винахідник",
          "sourceAnchor": "custom-origin-artificer",
          "blocks": [
            {
              "blockId": "block-section-custom-origin-artificer-1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Леонін не дає Винахіднику нічого унікального. Додаткова навичка приємна, а {{Грізний рик|Daunting Roar}} непогано стримує групи ворогів, проте жодна з цих можливостей не є необхідною Винахіднику."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "section-custom-origin-barbarian",
          "parentSectionId": "section-classes-custom-origin",
          "heading": "Варвар",
          "sourceAnchor": "custom-origin-barbarian",
          "blocks": [
            {
              "blockId": "block-section-custom-origin-barbarian-1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Додаткова навичка допомагає Варвару бути корисним поза боєм, а {{Грізний рик|Daunting Roar}} — проти груп ворогів, із чим Варвару зазвичай складно впоратися."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "section-custom-origin-bard",
          "parentSectionId": "section-classes-custom-origin",
          "heading": "Бард",
          "sourceAnchor": "custom-origin-bard",
          "blocks": [
            {
              "blockId": "block-section-custom-origin-bard-1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "{{Грізний рик|Daunting Roar}} заохочує входити в ближній бій, де Бардам зазвичай не місце. Навіть там ваші заклинання краще розвʼязують ту саму проблему."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "section-custom-origin-cleric",
          "parentSectionId": "section-classes-custom-origin",
          "heading": "Клірик",
          "sourceAnchor": "custom-origin-cleric",
          "blocks": [
            {
              "blockId": "block-section-custom-origin-cleric-1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Додаткова навичка та {{Грізний рик|Daunting Roar}}. Клірики мають багато способів впоратися з групами ворогів, а рев швидко відставатиме від вашого чаротворення."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "section-custom-origin-druid",
          "parentSectionId": "section-classes-custom-origin",
          "heading": "Друїд",
          "sourceAnchor": "custom-origin-druid",
          "blocks": [
            {
              "blockId": "block-section-custom-origin-druid-1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Додаткова навичка та {{Грізний рик|Daunting Roar}}. Рев може працювати в {{Дика форма|Wild Shape}} й бути корисним для Кола Спор, але його можна застосовувати недостатньо часто, щоб суттєво впливати на гру. Примітка редакції: Дика форма зберігає расові можливості лише тоді, коли нова форма фізично здатна їх використовувати."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "section-custom-origin-fighter",
          "parentSectionId": "section-classes-custom-origin",
          "heading": "Воїн",
          "sourceAnchor": "custom-origin-fighter",
          "blocks": [
            {
              "blockId": "block-section-custom-origin-fighter-1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Додаткова навичка допомагає Воїну бути корисним поза боєм, а {{Грізний рик|Daunting Roar}} — проти груп ворогів, із чим багатьом Воїнам зазвичай складно впоратися."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "section-custom-origin-monk",
          "parentSectionId": "section-classes-custom-origin",
          "heading": "Монах",
          "sourceAnchor": "custom-origin-monk",
          "blocks": [
            {
              "blockId": "block-section-custom-origin-monk-1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Додаткова навичка зменшує розрив у навичках між Монахом і Розбійником. Однак у ситуаціях, де можна використати {{Грізний рик|Daunting Roar}}, імовірно, ефективнішими будуть {{Терплячий захист|Patient Defense}} або {{Крок вітру|Step of the Wind}}."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "section-custom-origin-paladin",
          "parentSectionId": "section-classes-custom-origin",
          "heading": "Паладин",
          "sourceAnchor": "custom-origin-paladin",
          "blocks": [
            {
              "blockId": "block-section-custom-origin-paladin-1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Додаткова навичка розширює можливості поза соціальними навичками, а {{Грізний рик|Daunting Roar}} добре доповнює Клятву завоювання, яка сильно залежить від ефектів страху."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "section-custom-origin-ranger",
          "parentSectionId": "section-classes-custom-origin",
          "heading": "Слідопит",
          "sourceAnchor": "custom-origin-ranger",
          "blocks": [
            {
              "blockId": "block-section-custom-origin-ranger-1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Додаткова навичка зменшує розрив у навичках між Слідопитом і Розбійником. {{Грізний рик|Daunting Roar}} може допомогти проти груп ворогів, але Слідопити вже мають способи впоратися з ними, тож це незначне покращення."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "section-custom-origin-rogue",
          "parentSectionId": "section-classes-custom-origin",
          "heading": "Розбійник",
          "sourceAnchor": "custom-origin-rogue",
          "blocks": [
            {
              "blockId": "block-section-custom-origin-rogue-1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Додаткова навичка й Темнозір чудові для Розбійника, але їх можна отримати майже від будь-якої раси, а {{Грізний рик|Daunting Roar}} не допомагає цьому класу. Якщо треба налякати групу ворогів, просто використайте {{Хитра дія|Cunning Action}} і тікайте."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "section-custom-origin-sorcerer",
          "parentSectionId": "section-classes-custom-origin",
          "heading": "Чаклун",
          "sourceAnchor": "custom-origin-sorcerer",
          "blocks": [
            {
              "blockId": "block-section-custom-origin-sorcerer-1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Дальність {{Грізний рик|Daunting Roar}} надто мала для безпечного застосування."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "section-custom-origin-warlock",
          "parentSectionId": "section-classes-custom-origin",
          "heading": "Чорнокнижник",
          "sourceAnchor": "custom-origin-warlock",
          "blocks": [
            {
              "blockId": "block-section-custom-origin-warlock-1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Чорнокнижник підкласу Відьмацького клинка може оцінити {{Грізний рик|Daunting Roar}} як доповнення до обмеженого чаротворення, але іншим Чорнокнижникам його дальність надто мала для безпечного застосування."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "section-custom-origin-wizard",
          "parentSectionId": "section-classes-custom-origin",
          "heading": "Чарівник",
          "sourceAnchor": "custom-origin-wizard",
          "blocks": [
            {
              "blockId": "block-section-custom-origin-wizard-1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Дальність {{Грізний рик|Daunting Roar}} надто мала для безпечного застосування."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "section-classes-default",
          "heading": "Леонін: класи за стандартними правилами",
          "sourceAnchor": "classes-default",
          "blocks": [
            {
              "blockId": "block-section-classes-default-1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Цей розділ припускає, що ви "
                },
                {
                  "type": "emphasis",
                  "text": "не"
                },
                {
                  "type": "text",
                  "text": " використовуєте опціональні правила «Налаштування походження» з книги Казан Таші з усім або оновлену версію раси з книги Монстри Мультивсесвіту. Якщо використовуєте, прокрутіть до попереднього розділу. Примітка редакції: згадка MPMM — типовий текст шаблону; ця книга не містить оновленої раси леонінів."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "section-default-artificer",
          "parentSectionId": "section-classes-default",
          "heading": "Винахідник",
          "sourceAnchor": "default-artificer",
          "blocks": [
            {
              "blockId": "block-section-default-artificer-1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Немає підвищення Інтелекту."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "section-default-barbarian",
          "parentSectionId": "section-classes-default",
          "heading": "Варвар",
          "sourceAnchor": "default-barbarian",
          "blocks": [
            {
              "blockId": "block-section-default-barbarian-1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Сила й Статура — ідеальне поєднання. Кігті працюють із {{Лють|Rage}}, хоча зброя все одно буде кращою. {{Грізний рик|Daunting Roar}} — чудовий спосіб впоратися з групами ворогів, що Варвару зазвичай складно."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "section-default-bard",
          "parentSectionId": "section-classes-default",
          "heading": "Бард",
          "sourceAnchor": "default-bard",
          "blocks": [
            {
              "blockId": "block-section-default-bard-1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Володіння Залякуванням приємне, але його замало. Можна спробувати Барда Колегії доблесті, проте збірка від Сили в середніх обладунках надто залежить від кількох характеристик: потрібні 14 Спритності та високі Сила, Статура й Харизма, чого дуже складно досягти. Примітка редакції: леонін обирає володіння однією з чотирьох навичок; Залякування не надається автоматично."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "section-default-cleric",
          "parentSectionId": "section-classes-default",
          "heading": "Клірик",
          "sourceAnchor": "default-cleric",
          "blocks": [
            {
              "blockId": "block-section-default-cleric-1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Паладин — кращий вибір."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "section-default-druid",
          "parentSectionId": "section-classes-default",
          "heading": "Друїд",
          "sourceAnchor": "default-druid",
          "blocks": [
            {
              "blockId": "block-section-default-druid-1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Друїд із твариноподібною зовнішністю завжди здається цікавою ідеєю, але підвищення характеристик леоніна її не підтримують, а мало інших його рис особливо корисні Друїду."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "section-default-fighter",
          "parentSectionId": "section-classes-default",
          "heading": "Воїн",
          "sourceAnchor": "default-fighter",
          "blocks": [
            {
              "blockId": "block-section-default-fighter-1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Леонін підходить будь-якій збірці від Сили, а додаткове расове володіння навичкою дає вибір із кількох стандартних навичок Воїна."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "section-default-monk",
          "parentSectionId": "section-classes-default",
          "heading": "Монах",
          "sourceAnchor": "default-monk",
          "blocks": [
            {
              "blockId": "block-section-default-monk-1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Немає підвищення ані Спритності, ані Мудрості, а Монахи від Сили просто нежиттєздатні."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "section-default-paladin",
          "parentSectionId": "section-classes-default",
          "heading": "Паладин",
          "sourceAnchor": "default-paladin",
          "blocks": [
            {
              "blockId": "block-section-default-paladin-1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Не такий простий вибір, як Варвар чи Воїн, але все ще чудовий. Харизма дуже корисна Паладину, та її підвищення на 1-му рівні не є строго необхідним. Сила й Статура добре працюють, а расові навички леоніна включають Уважність, якої немає в переліку класових навичок Паладина."
                }
              ]
            },
            {
              "blockId": "block-section-default-paladin-2",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Завдяки {{Грізний рик|Daunting Roar}} залежність Клятви завоювання від ефектів страху робить її особливо привабливою порівняно з іншими підкласами Паладина."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "section-default-ranger",
          "parentSectionId": "section-classes-default",
          "heading": "Слідопит",
          "sourceAnchor": "default-ranger",
          "blocks": [
            {
              "blockId": "block-section-default-ranger-1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Збірки від Сили складні, але можливі."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "section-default-rogue",
          "parentSectionId": "section-classes-default",
          "heading": "Розбійник",
          "sourceAnchor": "default-rogue",
          "blocks": [
            {
              "blockId": "block-section-default-rogue-1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Немає підвищення Спритності, а леонін не має інших привабливих для Розбійника можливостей."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "section-default-sorcerer",
          "parentSectionId": "section-classes-default",
          "heading": "Чаклун",
          "sourceAnchor": "default-sorcerer",
          "blocks": [
            {
              "blockId": "block-section-default-sorcerer-1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Немає підвищення Харизми."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "section-default-warlock",
          "parentSectionId": "section-classes-default",
          "heading": "Чорнокнижник",
          "sourceAnchor": "default-warlock",
          "blocks": [
            {
              "blockId": "block-section-default-warlock-1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Немає підвищення Харизми."
                }
              ]
            }
          ]
        },
        {
          "sectionId": "section-default-wizard",
          "parentSectionId": "section-classes-default",
          "heading": "Чарівник",
          "sourceAnchor": "default-wizard",
          "blocks": [
            {
              "blockId": "block-section-default-wizard-1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Немає підвищення Інтелекту."
                }
              ]
            }
          ]
        }
      ]
    }
  ],
