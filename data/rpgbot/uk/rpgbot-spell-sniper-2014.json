          "sourceAnchor": "spell-sniper-spell-options",
          "blocks": [
            {
              "blockId": "block-section-spell-sniper-spell-options-1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Повний перелік доступних заклинань та їхні описи є на "
                },
                {
                  "type": "link",
                  "text": "DnDBeyond",
