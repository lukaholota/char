# ===== Sentry =====
# Обидві змінні містять ОДИН І ТОЙ САМИЙ рядок DSN. Різні вони не за значенням, а за тим,
# коли читаються:
#   SENTRY_DSN            — рантайм, серверна частина. Живе в char.env, міняється рестартом.
#   NEXT_PUBLIC_SENTRY_DSN — вшивається в клієнтський бандл під час `next build`. У char.env
#                            класти безглуздо: у рантаймі Next її вже не читає. Вона має бути
#                            в GitHub Secrets і в build-args джоби `image` (див. deploy.yml).
# DSN не є секретом — він однаково їде в браузер кожного користувача.
# SENTRY_DSN="https://<key>@o<org>.ingest.de.sentry.io/<project>"
# NEXT_PUBLIC_SENTRY_DSN="https://<key>@o<org>.ingest.de.sentry.io/<project>"

# Відкриває /sentry-check і /api/sentry-check, які навмисно кидають помилку. Поки змінна
# порожня, обидва маршрути віддають 404 — щоб ніхто сторонній не вичерпав безкоштовну квоту.
# SENTRY_CHECK_TOKEN="довгий-випадковий-рядок"

# ===== PostHog =====
# На відміну від Sentry, серверної половини тут немає — PostHog у цьому проєкті лише
# клієнтський (persistence: memory, без autocapture, без Session Replay — рішення власника
# 2026-08-12, docs/MONITORING.md). Обидві змінні вшиваються в клієнтський бандл під час
# `next build`, у char.env їх класти безглуздо. Мають бути в GitHub Secrets і build-args
# джоби `image` (див. deploy.yml).
# NEXT_PUBLIC_POSTHOG_KEY="phc_..."
# NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# Відкриває /posthog-check, який навмисно шле подію posthog_check. Поки змінна порожня,
# маршрут віддає 404 — той самий запобіжник, що SENTRY_CHECK_TOKEN.
# POSTHOG_CHECK_TOKEN="довгий-випадковий-рядок"

# ===== Telegram: репорти «Повідомити про проблему» =====
# Рантайм, живуть у char.env. Поки хоч одна порожня, репорт лише пишеться в problem_report.
# Токен дає @BotFather; chat_id — поле message.chat.id з
# https://api.telegram.org/bot<TOKEN>/getUpdates після першого повідомлення боту.
# TELEGRAM_BOT_TOKEN="123456789:AA..."
# TELEGRAM_CHAT_ID="123456789"

# ===== PDF / Print runtime configuration =====
# These are read at runtime by the Next.js server process (systemd service `char`).
# Put them into your VPS service environment (systemd override / EnvironmentFile)
# or export them in the shell that starts the server.

# 1) Prefer system-installed Chromium/Chrome (most stable on VPS)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# 2) If you do NOT want to install a browser on the OS, try Sparticuz bundled Chromium.
# Note: can increase cold-start time.
# PUPPETEER_USE_SPARTICUZ=1

# 3) Use /dev/shm (faster than disk on HDD). Set to 0 to NOT disable dev-shm usage.
# PUPPETEER_DISABLE_DEV_SHM_USAGE=0

# 4) Timeouts (ms) for HTML -> PDF rendering
# PDF_SET_CONTENT_TIMEOUT_MS=60000
# PDF_RENDER_TIMEOUT_MS=60000

# 5) Puppeteer launch diagnostics
# Increase if Chromium is slow to start on the VPS.
# PUPPETEER_LAUNCH_TIMEOUT_MS=120000

# Print Chromium stdout/stderr into logs (useful when Chromium can't start due to missing libs).
# PUPPETEER_DUMPIO=1

# Fail the whole PDF if any section (features/spells/magic-items) fails.
# Useful for debugging, because otherwise the code may return only the character sheet page.
# PDF_STRICT_SECTIONS=1
