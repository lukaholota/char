# Похідні з бази каталоги більше НЕ ігноруються. Вони лежать у git поряд із
# creatures.json, який відстежувався від початку, і саме вони їдуть у збірку.
# Базу регенерують явним `bun run generate:content` і комітять результат — CI її
# для контенту не питає. Причина: збірка пекла каталоги з `spells_ci_test`, тобто
# сайт показував дані клона, а не те, що в репозиторії. Рішення власника 2026-08-28.

/spell-list

# Сирий кеш сторінок aidedd — відтворюється scripts/aidedd/fetch-pages.ts.
# Переліки (lists/) і реєстр термінів у git лишаються, бо це вхід для рев'ю.
data/aidedd/raw/
# Сирий корпус 5etools — відтворюється scripts/5etools/fetch-source.ts за пінутою
# ревізією дзеркала. Чужі дані й десятки мегабайт; замок (source-lock.json) у git лишається.
data/5etools/raw/
# Дампи БД — реальні дані користувачів, у git їм не місце.
backups/
*.dump
/tmp

# логи автономних прогонів партій KR12.3
logs/
data/aidedd/briefings/
