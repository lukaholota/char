{
  "name": "pers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:classic": "next dev",
    "generate:spells": "tsx scripts/generate-spells.ts",
    "generate:magic-items": "tsx scripts/generate-magic-items.ts",
    "generate:feats": "tsx scripts/generate-feats.ts",
    "generate:backgrounds": "tsx scripts/generate-backgrounds.ts",
    "generate:armor": "tsx scripts/generate-armor.ts",
    "generate:weapons": "tsx scripts/generate-weapons.ts",
    "generate:infusions": "tsx scripts/generate-infusions.ts",
    "generate:invocations": "tsx scripts/generate-invocations.ts",
    "generate:rules-2024": "tsx scripts/generate-rules-2024.ts",
    "generate:content": "npm run generate:spells && npm run generate:magic-items && npm run generate:feats && npm run generate:backgrounds && npm run generate:armor && npm run generate:weapons && npm run generate:infusions && npm run generate:invocations && npm run generate:rules-2024",
    "seed:magic-items:test": "bun tsx scripts/seed-magic-items.ts --target test",
    "seed:magic-items:prod": "bun tsx scripts/seed-magic-items.ts --target prod",
    "prebuild": "npm run generate:content",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:db-boundary": "bun ./node_modules/dependency-cruiser/bin/dependency-cruise.mjs --config .dependency-cruiser.cjs src",
    "check:ui-decomposition": "bun scripts/check-ui-decomposition.ts",
    "fetch:5etools": "tsx scripts/5etools/fetch-source.ts",
    "coverage:5etools": "tsx scripts/5etools/build-coverage.ts",
    "compare:spells:2024": "tsx scripts/5etools/compare-spells.ts --edition=2024",
    "compare:spells:2014": "tsx scripts/5etools/compare-spells.ts --edition=2014",
    "compare:prose:2024": "tsx scripts/5etools/compare-spell-prose.ts",
  "rank:stale-2024": "tsx scripts/5etools/rank-stale-2024-text.ts",
    "find:missing-2014": "tsx scripts/5etools/find-missing-2014-spells.ts",
    "build:spell-lists": "tsx scripts/5etools/build-extended-spell-lists.ts",
    "parse:class-features-2024": "bun tsx scripts/2024/parse-class-features.ts",
    "verify:class-features-2024": "bun tsx scripts/2024/verify-class-features.ts",
    "seed:2024:test": "bun tsx scripts/seed-2024.ts --target test",
    "seed:2024:prod": "bun tsx scripts/seed-2024.ts --target prod",
    "seed:spell-fixes:test": "bun tsx scripts/seed-2014-spell-fixes.ts --target test",
    "seed:spell-fixes:prod": "bun tsx scripts/seed-2014-spell-fixes.ts --target prod",
    "seed:spell-lists:test": "bun tsx scripts/seed-2014-spell-lists.ts --target test",
    "seed:spell-lists:prod": "bun tsx scripts/seed-2014-spell-lists.ts --target prod",
    "test": "./scripts/with-test-db-lock.sh vitest run",
    "test:unit": "./scripts/with-test-db-lock.sh vitest run",
    "test:integration": "./scripts/with-test-db-lock.sh vitest run --config vitest.integration.config.mts",
    "test:db": "./scripts/with-test-db-lock.sh vitest run --config vitest.integration.config.mts",
    "test:all": "bun run test && bun run test:integration",
    "test:watch": "vitest",
    "test:coverage": "./scripts/with-test-db-lock.sh vitest run --coverage",
    "test:rules:coverage": "vitest run --config vitest.rules.config.mts --coverage",
    "test:golden:update": "./scripts/with-test-db-lock.sh env UPDATE_GOLDEN=1 vitest run tests/golden",
    "test:e2e": "playwright test",
    "db:pull": "prisma db pull && prisma format && prisma generate && bun run db:dump",
    "db:dump": "./scripts/db-dump.sh"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@3d-dice/dice-box": "^1.1.4",
    "@auth/prisma-adapter": "^2.11.1",
    "@hookform/resolvers": "^5.2.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.3.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@sentry/nextjs": "^10.70.0",
    "@sparticuz/chromium": "^143.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.23.26",
    "google-auth-library": "^10.5.0",
    "lucide-react": "^0.555.0",
    "next": "^16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "posthog-js": "^1.415.6",
    "puppeteer-core": "^24.34.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.66.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark": "^15.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "sonner": "^2.0.7",
    "swiper": "^12.1.2",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.6",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.21",
    "dependency-cruiser": "16.10.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "jscpd": "4.0.5",
    "postcss": "^8.5.6",
    "prisma": "^7.3.0",
    "tailwindcss": "^3.4.13",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
